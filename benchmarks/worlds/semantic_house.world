<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="semantic_house">
    <!-- Deterministic physics parameters -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Ambient & Sun Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ==================== OUTER BOUNDARY WALLS ==================== -->
    <!-- North Wall -->
    <model name="wall_outer_north">
      <static>true</static>
      <pose>0.0 5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>12.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>12.0 0.2 2.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>
    <!-- South Wall -->
    <model name="wall_outer_south">
      <static>true</static>
      <pose>0.0 -5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>12.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>12.0 0.2 2.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>
    <!-- East Wall -->
    <model name="wall_outer_east">
      <static>true</static>
      <pose>6.0 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 10.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 10.0 2.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>
    <!-- West Wall -->
    <model name="wall_outer_west">
      <static>true</static>
      <pose>-6.0 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 10.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 10.0 2.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>

    <!-- ==================== ROOM PARTITION WALLS ==================== -->
    <!-- Divider: Living Room (East) vs Kitchen (West) with Doorway -->
    <model name="wall_divider_north_1">
      <static>true</static>
      <pose>0.0 3.2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 3.4 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 3.4 2.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- Divider: Storage Room vs Corridor with Doorway -->
    <model name="wall_divider_south_1">
      <static>true</static>
      <pose>0.0 -3.2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 3.4 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 3.4 2.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- ==================== 3D SEMANTIC LANDMARK OBJECTS ==================== -->
    <!-- 1. Red Sofa (Living Room at x: 3.2, y: 3.0) -->
    <model name="semantic_red_sofa">
      <static>true</static>
      <pose>3.2 3.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.6 0.8 0.7</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.6 0.8 0.7</size></box></geometry>
          <material>
            <ambient>0.85 0.15 0.15 1</ambient>
            <diffuse>0.85 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2. Kitchen Table (Kitchen at x: -2.2, y: 2.5) -->
    <model name="semantic_kitchen_table">
      <static>true</static>
      <pose>-2.2 2.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.4 1.0 0.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.4 1.0 0.8</size></box></geometry>
          <material>
            <ambient>0.2 0.45 0.85 1</ambient>
            <diffuse>0.2 0.45 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 3. Storage Cargo Boxes (Storage Bay at x: 2.8, y: -1.8) -->
    <model name="semantic_storage_boxes">
      <static>true</static>
      <pose>2.8 -1.8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.9 0.9 0.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.9 0.9 0.8</size></box></geometry>
          <material>
            <ambient>0.9 0.6 0.1 1</ambient>
            <diffuse>0.9 0.6 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 4. Charging Dock Target (Docking Bay at x: 0.0, y: -3.2) -->
    <model name="semantic_charging_dock">
      <static>true</static>
      <pose>0.0 -3.2 0.1 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.5 0.4 0.2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.4 0.2</size></box></geometry>
          <material>
            <ambient>0.1 0.8 0.3 1</ambient>
            <diffuse>0.1 0.8 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
