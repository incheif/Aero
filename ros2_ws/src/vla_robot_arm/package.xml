<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vla_robot_arm</name>
  <version>1.0.0</version>
  <description>ROS 2 Autonomous Robotic Arm Manipulation driven by Google Vision-Language-Action (VLA), 3D Semantic Spatial Mapping, and Frontier Exploration.</description>
  <maintainer email="developer@example.com">Robotics Developer</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
