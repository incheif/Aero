# ==============================================================================
# Google VLA Robotics Studio - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env': 
#    powershell: cp .env.example .env
# 2. Paste your Google AI Studio API key below.
# 3. NEVER commit your actual '.env' file to GitHub (.gitignore will ignore it).
# ==============================================================================

# Google Gemini API Key (Get one free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (Options: gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Server Host & Port
HOST=127.0.0.1
PORT=8000
